# --- Anthropic ---
# Leave ANTHROPIC_API_KEY unset if you authenticate via `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-...
# Model used for enrichment + scoring. Defaults to the latest Opus.
LLM_MODEL=claude-opus-4-8

# --- Scoring ---
# Rows are flagged in the sheet when confidence_score is strictly above this.
CONFIDENCE_THRESHOLD=0.7

# --- Google Sheets ---
# Path to a Google service-account JSON key with edit access to the sheet.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# The spreadsheet key (the long id in the sheet URL) and the worksheet/tab name.
GOOGLE_SHEET_ID=1AbC...xyz
GOOGLE_WORKSHEET_NAME=Leads

# --- Webhook security (optional) ---
# If set, incoming webhooks must send this value in the `X-Webhook-Token` header.
WEBHOOK_TOKEN=
